# EXP-2: Data Partitioning, Smoothing and Histogram

# Given item price data
data <- c(1, 1, 5, 5, 5, 5, 5, 8, 8, 10,
          10, 10, 10, 12, 14, 14, 14, 15, 15, 15,
          15, 15, 15, 18, 18, 18, 18, 18, 18, 20,
          20, 20, 20, 20, 20, 20, 21, 21, 21, 21,
          25, 25, 25, 25, 25, 28, 28, 30)

# Sort the data
data <- sort(data)

# Divide data into 3 equal-frequency bins
bins <- split(data, rep(1:3, each = length(data) / 3))

cat("Equal-Frequency Bins:\n")
print(bins)

# Smoothing by bin means
cat("\nSmoothing by Bin Means:\n")
bin_means <- lapply(bins, function(x) {
  rep(mean(x), length(x))
})
print(bin_means)

# Smoothing by bin boundaries
cat("\nSmoothing by Bin Boundaries:\n")
bin_boundaries <- lapply(bins, function(x) {
  lower <- min(x)
  upper <- max(x)

  sapply(x, function(value) {
    if (abs(value - lower) <= abs(value - upper)) {
      lower
    } else {
      upper
    }
  })
})
print(bin_boundaries)

# Draw histogram
hist(data,
     main = "Histogram of Item Prices",
     xlab = "Price",
     ylab = "Frequency",
     col = "lightblue",
     breaks = 3)
