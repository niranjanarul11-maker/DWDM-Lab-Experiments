# EXP-7: Linear Regression Using Water Dataset

# Install the package if required
# install.packages("MASS")

# Load the package
library(MASS)

# Load the water dataset
data("water")

# Display the dataset
print(water)

# Draw scatter plot
plot(water$hardness, water$mortality,
     main = "Mortality vs Water Hardness",
     xlab = "Hardness",
     ylab = "Mortality",
     pch = 19,
     col = "blue")

# Fit linear regression model
model <- lm(mortality ~ hardness, data = water)

# Display model summary
print(summary(model))

# Add regression line
abline(model, col = "red", lwd = 2)

# Predict mortality when hardness is 88
new_data <- data.frame(hardness = 88)
prediction <- predict(model, newdata = new_data)

cat("Predicted mortality when hardness = 88:",
    prediction, "\n")
