# EXP-9: Outlier Detection Using Boxplot

# Tennis players' scores
scores <- c(12, 15, 18, 20, 22, 24, 25, 26,
            28, 30, 32, 35, 38, 40, 100)

# Display scores
cat("Tennis Players' Scores:\n")
print(scores)

# Draw boxplot
boxplot(scores,
        main = "Tennis Scores - Outlier Detection",
        xlab = "Tennis Players",
        ylab = "Scores",
        col = "lightblue")

# Identify outliers using the IQR method
Q1 <- quantile(scores, 0.25)
Q3 <- quantile(scores, 0.75)
IQR_value <- IQR(scores)

lower_limit <- Q1 - 1.5 * IQR_value
upper_limit <- Q3 + 1.5 * IQR_value

outliers <- scores[scores < lower_limit |
                   scores > upper_limit]

cat("\nPossible Outliers:\n")
print(outliers)
