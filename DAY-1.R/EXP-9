# EXP-9: Data Partitioning and Histogram

# Given data
marks <- c(55, 60, 71, 63, 55, 65, 50, 55, 58,
           59, 61, 63, 65, 67, 71, 72, 75)

# Sort the data
sorted_marks <- sort(marks)

# Equal-frequency partitioning into 3 bins
cat("Equal-Frequency Partitioning:\n")
bins <- split(sorted_marks,
              cut(seq_along(sorted_marks),
                  breaks = 3, labels = FALSE))
print(bins)

# Equal-width partitioning into 3 bins
cat("Equal-Width Partitioning:\n")
width <- (max(marks) - min(marks)) / 3

bin1 <- marks[marks <= min(marks) + width]
bin2 <- marks[marks > min(marks) + width &
              marks <= min(marks) + 2 * width]
bin3 <- marks[marks > min(marks) + 2 * width]

print(list(Bin1 = bin1, Bin2 = bin2, Bin3 = bin3))

# Plot histogram
hist(marks,
     main = "Histogram of Marks",
     xlab = "Marks",
     ylab = "Frequency",
     col = "lightblue",
     breaks = 3)
