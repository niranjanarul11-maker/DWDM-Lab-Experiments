# EXP-7: Calculate Mean, Median, and Mode

# Given data
pencils <- c(9, 25, 23, 12, 11, 6, 7, 8, 9, 10)

# Calculate mean
cat("Mean:", mean(pencils), "\n")

# Calculate median
cat("Median:", median(pencils), "\n")

# Calculate mode
mode_value <- as.numeric(names(which.max(table(pencils))))
cat("Mode:", mode_value, "\n")
