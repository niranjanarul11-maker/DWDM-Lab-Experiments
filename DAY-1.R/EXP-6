# EXP-6: Data Normalization

# Given age data
age <- c(13, 15, 16, 16, 19, 20, 20, 21, 22, 22,
         25, 25, 25, 25, 30, 33, 33, 35, 35, 35,
         35, 36, 40, 45, 46, 52, 70)

x <- 35

# (i) Min-Max Normalization
min_value <- min(age)
max_value <- max(age)

min_max <- (x - min_value) / (max_value - min_value)
cat("Min-Max Normalization:", min_max, "\n")

# (ii) Z-Score Normalization
z_score <- (x - mean(age)) / 12.94
cat("Z-Score Normalization:", z_score, "\n")

# (iii) Decimal Scaling Normalization
j <- ceiling(log10(max(abs(age))))
decimal_scaling <- x / (10^j)
cat("Decimal Scaling Normalization:", decimal_scaling, "\n")
