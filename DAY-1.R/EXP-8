# EXP-8: Scatter Plot Using scatter.smooth()

# Given data
x <- c(4, 1, 5, 7, 10, 2, 50, 25, 90, 36)
y <- c(12, 5, 13, 19, 31, 7, 153, 72, 275, 110)

# Draw scatter plot with a smooth curve
scatter.smooth(x, y,
               main = "Number of Phones Sold vs Money",
               xlab = "Number of Phones Sold",
               ylab = "Money",
               pch = 19)
