# EXP-4: Smoothing by Binning

# Given data
data <- c(11, 13, 13, 15, 15, 16, 19, 20, 20, 20,
          21, 21, 22, 23, 24, 30, 40, 45, 45, 45,
          71, 72, 73, 75)

# Divide data into bins of 3 values
bins <- split(data, ceiling(seq_along(data) / 3))

# Smoothing by bin means
cat("Smoothing by Bin Means:\n")
for (b in bins) {
  print(rep(mean(b), length(b)))
}

# Smoothing by bin medians
cat("Smoothing by Bin Medians:\n")
for (b in bins) {
  print(rep(median(b), length(b)))
}

# Smoothing by bin boundaries
cat("Smoothing by Bin Boundaries:\n")
for (b in bins) {
  lower <- min(b)
  upper <- max(b)
  smoothed <- sapply(b, function(x) {
    if (abs(x - lower) <= abs(x - upper)) lower else upper
  })
  print(smoothed)
}
